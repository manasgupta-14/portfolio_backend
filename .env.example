# Copy this file to ".env" and put your real values in ".env" (never in this example file).

PORT=5000
# Frontend URL(s) allowed to call this API (comma separated, NO trailing slash)
# On Render set: https://portfolio-manas-gupta.vercel.app
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string, e.g.
# mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority
# (URL-encode special characters in the password)
MONGODB_URI=

# Admin panel login (/admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# any long random string
JWT_SECRET=
