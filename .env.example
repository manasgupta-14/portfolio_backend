# ---------- Server ----------
PORT=5000
# Frontend URL(s) allowed to call this API (comma separated)
CLIENT_URL=http://localhost:5173

# ---------- MongoDB Atlas ----------
# Paste your Atlas connection string here
MONGODB_URI=

# ---------- Admin login (used for /admin panel) ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=
# any long random string
JWT_SECRET=

# ---------- Contact form -> Email (Gmail example) ----------
# Gmail: enable 2-step verification, then create an "App Password"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# where messages are delivered (defaults to SMTP_USER)
MAIL_TO=

# ---------- Contact form -> WhatsApp ----------
# provider: callmebot (free, personal number) | twilio
WHATSAPP_PROVIDER=callmebot
# your number with country code, digits only, e.g. 919555998119
WHATSAPP_PHONE=
# CallMeBot: apikey you receive after activation (see README)
CALLMEBOT_APIKEY=
# Twilio (only if WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
